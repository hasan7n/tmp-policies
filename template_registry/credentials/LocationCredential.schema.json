{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "LocationCredential",
  "title": "LocationCredential",
  "description": "The assignee's organization physical address; issuer claims the subject has an address.",
  "x-subject": "An organization",
  "x-issuer": "Sage / User Platform",
  "type": "object",
  "properties": {
    "locatedAt": {
      "type": "object",
      "description": "Physical address of the organization.",
      "properties": {
        "street": {
          "type": "string",
          "description": "Street address."
        },
        "zipCode": {
          "type": "string",
          "description": "Postal / ZIP code."
        },
        "state": {
          "type": "string",
          "description": "State or region."
        },
        "country": {
          "type": "string",
          "description": "Country."
        }
      },
      "required": ["street", "zipCode", "state", "country"],
      "additionalProperties": false
    }
  },
  "required": ["locatedAt"],
  "additionalProperties": false
}
