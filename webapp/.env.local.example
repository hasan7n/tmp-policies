# Bare-metal (local) configuration. Copy to `.env`; config/settings.py loads it
# when you run ./run.sh. Every variable is required (settings has no defaults).
# Point the paths at your local PDO install and input files.

# PDO install root of your local build (PDO_HOME is ${PDO_INSTALL_ROOT}/opt/pdo).
PDO_INSTALL_ROOT=/home/youruser/pdo/install

# Ledger.
PDO_LEDGER_URL=http://localhost:6600
PDO_LEDGER_TYPE=ccf

# Service host (name of the site whose toml is imported at bootstrap).
F_SERVICE_HOST=localhost

# PDO input files (real paths on this machine).
LEDGER_CERT_PATH=/home/youruser/pdo/keys/networkcert.pem
SITE_TOML_SOURCE=/home/youruser/pdo/etc/site.toml
USER_KEYS_FOLDER=/home/youruser/pdo/user_keys

# Preferred eservice ("random" to pick one from the group).
PREFERRED_ESERVICE_URL=random

# Registry endpoints.
ASSET_REGISTRY_URL=http://localhost:8001
TEMPLATE_REGISTRY_URL=http://localhost:8002

# Logging (__screen__ logs to stdout).
PDO_LOG_FILE=__screen__
PDO_LOG_LEVEL=warn
