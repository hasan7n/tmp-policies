# Docker configuration. Copy to `.env`; run_docker.sh mounts it into the
# container at /webapp/.env, where config/settings.py loads it. Every variable
# is required (settings has no defaults). The paths below are the fixed
# in-container locations that run_docker.sh bind-mounts the host files onto.

# PDO install (matches PDO_INSTALL_ROOT baked into the client base image).
PDO_INSTALL_ROOT=/pdo_install

# Ledger.
PDO_LEDGER_URL=http://192.168.1.223:6600
PDO_LEDGER_TYPE=ccf

# Service host (name of the site whose toml is imported at bootstrap).
F_SERVICE_HOST=

# PDO input files (bind-mounted by run_docker.sh onto these container paths).
LEDGER_CERT_PATH=/tmp/networkcert.pem
SITE_TOML_SOURCE=/tmp/site.toml
USER_KEYS_FOLDER=/tmp/user_keys

# Preferred eservice ("random" to pick one from the group).
PREFERRED_ESERVICE_URL=random

# Registry endpoints.
ASSET_REGISTRY_URL=http://192.168.1.223:8001
TEMPLATE_REGISTRY_URL=http://192.168.1.223:8002

# Logging (__screen__ logs to stdout).
PDO_LOG_FILE=__screen__
PDO_LOG_LEVEL=warn
